# ============ 服务配置 ============
# 后端服务端口
PORT=3000

# ============ MySQL 数据库配置 ============
# 改成你自己的数据库账号密码
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=123456
DB_NAME=campus_secondhand

# ============ JWT 配置 ============
# 登录校验密钥：必须与"登录注册"模块（张三）签发 token 时使用的密钥一致
JWT_SECRET=campus_secondhand_secret_key
